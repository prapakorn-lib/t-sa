<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Concert Ticket Booking System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            font-size: 2.5em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .concert-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .concert-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .concert-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        .concert-name {
            font-size: 1.5em;
            color: #667eea;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .concert-artist {
            font-size: 1.2em;
            color: #555;
            margin-bottom: 15px;
        }

        .concert-details {
            color: #666;
            margin-bottom: 10px;
            line-height: 1.8;
        }

        .concert-details strong {
            color: #333;
            display: inline-block;
            width: 120px;
        }

        .price {
            font-size: 1.3em;
            color: #27ae60;
            font-weight: bold;
            margin: 15px 0;
        }

        .available {
            color: #e74c3c;
            font-weight: bold;
        }

        .booking-form {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            margin-top: 30px;
        }

        .booking-form h2 {
            color: #667eea;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1em;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #667eea;
        }

        .btn-book {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 40px;
            border: none;
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease;
            width: 100%;
        }

        .btn-book:hover {
            transform: scale(1.05);
        }

        .message {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }

        .message.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .message.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎵 Concert Ticket Booking System 🎵</h1>

        <div class="concert-grid">
            <% concerts.forEach(concert => { %>
                <div class="concert-card">
                    <div class="concert-name"><%= concert.name %></div>
                    <div class="concert-artist">🎤 <%= concert.artist %></div>
                    <div class="concert-details">
                        <strong>วันที่:</strong> <%= new Date(concert.date).toLocaleDateString('th-TH') %><br>
                        <strong>สถานที่:</strong> <%= concert.venue %><br>
                        <strong>ราคา:</strong> <span class="price"><%= concert.price.toLocaleString() %> บาท</span><br>
                        <strong>ตั๋วคงเหลือ:</strong> <span class="available"><%= concert.available_tickets %> / <%= concert.total_tickets %></span>
                    </div>
                </div>
            <% }); %>
        </div>

        <div class="booking-form">
            <h2>📝 จองตั๋วคอนเสิร์ต</h2>
            <div id="message" class="message"></div>
            <form id="bookingForm">
                <div class="form-group">
                    <label for="concert_id">เลือกคอนเสิร์ต:</label>
                    <select id="concert_id" name="concert_id" required>
                        <option value="">-- เลือกคอนเสิร์ต --</option>
                        <% concerts.forEach(concert => { %>
                            <option value="<%= concert.id %>">
                                <%= concert.name %> - <%= concert.artist %> (<%= concert.available_tickets %> ที่นั่งเหลือ)
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="customer_name">ชื่อ-นามสกุล:</label>
                    <input type="text" id="customer_name" name="customer_name" required>
                </div>
                <div class="form-group">
                    <label for="customer_email">อีเมล:</label>
                    <input type="email" id="customer_email" name="customer_email" required>
                </div>
                <div class="form-group">
                    <label for="num_tickets">จำนวนตั๋ว:</label>
                    <input type="number" id="num_tickets" name="num_tickets" min="1" max="10" required>
                </div>
                <button type="submit" class="btn-book">จองตั๋ว</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('bookingForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = {
                concert_id: parseInt(document.getElementById('concert_id').value),
                customer_name: document.getElementById('customer_name').value,
                customer_email: document.getElementById('customer_email').value,
                num_tickets: parseInt(document.getElementById('num_tickets').value)
            };

            const messageDiv = document.getElementById('message');

            try {
                const response = await fetch('/api/bookings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (response.ok) {
                    messageDiv.className = 'message success';
                    messageDiv.textContent = '✅ ' + data.message + ' - จองตั๋วสำเร็จ!';
                    messageDiv.style.display = 'block';
                    document.getElementById('bookingForm').reset();
                    setTimeout(() => location.reload(), 2000);
                } else {
                    messageDiv.className = 'message error';
                    messageDiv.textContent = '❌ ' + data.error;
                    messageDiv.style.display = 'block';
                }
            } catch (error) {
                messageDiv.className = 'message error';
                messageDiv.textContent = '❌ เกิดข้อผิดพลาด: ' + error.message;
                messageDiv.style.display = 'block';
            }
        });
    </script>
</body>
</html>
